# ===== 应用配置 =====
APP_NAME=Expense-Agent
DEBUG=true
PORT=8000

# ===== LLM 配置（默认 DeepSeek，国内直连）=====
# DeepSeek: https://platform.deepseek.com/ 注册获取 API Key
# 通义千问: 把 BASE_URL 改成 https://dashscope.aliyuncs.com/compatible-mode/v1，MODEL 改成 qwen-plus
# Kimi:     把 BASE_URL 改成 https://api.moonshot.cn/v1，MODEL 改成 moonshot-v1-8k
LLM_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== 百度 OCR API =====
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key

# ===== 飞书配置 =====
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_BOT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
FEISHU_VERIFICATION_TOKEN=your-verification-token

# ===== 规则配置 =====
COMPANY_NAME=XX科技有限公司
EXPENSE_MONTHLY_LIMIT=3000
EXPENSE_SINGLE_LIMIT=500
EXPENSE_DATE_RANGE_DAYS=7
